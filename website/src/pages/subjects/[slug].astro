---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MasonryGrid from '../../components/MasonryGrid.astro';
import { getPhotosBySubject } from '../../lib/photos';

export async function getStaticPaths() {
	const subjects = await getCollection('subjects');
	return subjects.map((subject) => ({
		params: { slug: subject.id },
		props: { subject },
	}));
}

const { subject } = Astro.props;
const photos = await getPhotosBySubject(subject.id);
const countLabel =
	photos.length === 1 ? '1 photograph' : `${photos.length} photographs`;
---

<Layout title={subject.data.title} description={subject.data.description}>
	<nav class="crumb" aria-label="Breadcrumb">
		<a href="/">Work</a>
		<span aria-hidden="true">/</span>
		<span>{subject.data.title}</span>
	</nav>

	<header class="page-header">
		<h1>{subject.data.title}</h1>
		{subject.data.description ? <p>{subject.data.description}</p> : null}
		<p class="count">{countLabel}</p>
	</header>

	<MasonryGrid photos={photos} subjectTitle={subject.data.title} />
</Layout>

<style>
	.crumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		font-size: 0.85rem;
		color: var(--text-faint);
	}

	.crumb a {
		color: var(--text-muted);
		text-decoration: none;
	}

	.crumb a:hover {
		color: var(--text);
	}

	.count {
		margin-top: 0.85rem;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
</style>
