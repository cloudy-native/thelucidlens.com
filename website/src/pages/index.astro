---
import Layout from '../layouts/Layout.astro';
import SubjectCard from '../components/SubjectCard.astro';
import { getPhotoCounts, getSubjects } from '../lib/photos';

const subjects = await getSubjects();
const counts = await getPhotoCounts();
---

<Layout
	title="The Lucid Lens"
	description="A multi-subject photography portfolio."
>
	<header class="hero">
		<p class="hero__kicker">Photography</p>
		<h1 class="hero__title">
			<span>Stephen Harrison Photographer</span>
		</h1>
		<p class="hero__lede">
			Open a collection, then click any frame for the full image and
			details.
		</p>
	</header>

	{
		subjects.length === 0 ? (
			<p class="empty">
				No subjects yet. Add markdown files under <code>src/content/subjects</code>.
			</p>
		) : (
			<section class="subject-grid" aria-label="Subject collections">
				{subjects.map((subject) => (
					<SubjectCard
						title={subject.data.title}
						description={subject.data.description}
						href={`/subjects/${subject.id}`}
						cover={subject.data.cover}
						count={counts.get(subject.id) ?? 0}
					/>
				))}
			</section>
		)
	}
</Layout>

<style>
	.hero {
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
		padding-block: clamp(1.5rem, 5vw, 3.5rem) 0.5rem;
		max-width: 28rem;
	}

	.hero__kicker {
		margin: 0 0 1rem;
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.hero__title {
		display: flex;
		flex-direction: column;
		margin: 0 0 1.25rem;
		font-size: clamp(2.6rem, 7vw, 4.25rem);
		font-weight: 300;
		letter-spacing: -0.03em;
		line-height: 1.02;
		color: var(--text);
	}

	.hero__lede {
		margin: 0;
		max-width: 22rem;
		font-size: 0.95rem;
		color: var(--text-muted);
		line-height: 1.55;
	}

	.subject-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem 1.25rem;
	}

	@media (min-width: 640px) {
		.subject-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1000px) {
		.subject-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2.25rem 1.35rem;
		}
	}

	.empty {
		color: var(--text-muted);
	}

	.empty code {
		font-size: 0.85em;
		background: var(--bg-muted);
		padding: 0.1em 0.35em;
	}
</style>
