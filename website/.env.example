PORTFOLIO_SOURCE=/Volumes/Recordings/portfolio

# Photo CDN (CloudFront) — no trailing slash
PHOTO_BASE_URL=https://photos.thelucidlens.com

# Stack-created photo bucket (from TheLucidLensStack output PhotoBucketName)
# PHOTO_S3_BUCKET=thelucidlensstack-photobucketxxxxxxxx-xxxxxxxxxxxx
# AWS_PROFILE=default
